# Pipeline outputs (regenerable from source + code) — all of data/ is derived
# ...except data/golden/ (eval benchmark + recorded baselines — version-controlled
# so retrieval comparisons stay stable across sessions)
data/*
!data/golden/
!data/bench/
# The book catalog is reviewed by hand and read at runtime, so it is versioned.
!data/catalog.json
!data/intake/
data/bench/transcripts/
data/bench/calls/
# ...but the audit judge-sample batches are bulky reproducible scratch (regen via audit_prep.py)
data/golden/audit/sample_batch_*.jsonl

