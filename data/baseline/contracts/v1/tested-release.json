                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "location",
                "sha256",
                "bytes"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "state",
          "evidence",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "pending_gates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rollback": {
      "type": "object",
      "properties": {
        "routing": {
          "type": "string",
          "minLength": 1
        },
        "membership_manifest": {
          "type": "object",
          "properties": {
            "location": {
              "type": "object",
              "properties": {
                "backend": {
                  "enum": [
                    "repo",
                    "main-checkout",
                    "pi-mind",
                    "bppc"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "backend",
                "path"
              ],
              "additionalProperties": false
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "location",
            "sha256",
            "bytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "routing",
        "membership_manifest"
      ],
      "additionalProperties": false
    },
    "mutable_state_policy": {
      "type": "object",
      "properties": {
        "journal_in_release": {
          "const": false
        },
        "outbox_in_release": {
          "const": false
        },
        "install_preserves_journal_and_outbox": {
          "const": true
        }
      },
      "required": [
        "journal_in_release",
        "outbox_in_release",
        "install_preserves_journal_and_outbox"
      ],
      "additionalProperties": false
    }
