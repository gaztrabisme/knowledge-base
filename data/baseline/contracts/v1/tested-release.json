    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "verified",
              "pending",
              "excluded"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "location": {
                  "type": "object",
                  "properties": {
                    "backend": {
                      "enum": [
                        "repo",
                        "main-checkout",
                        "pi-mind",
                        "bppc"
                      ]
