  "required": [
    "schema_version",
    "release_id",
    "created_at",
    "deployment_state",
    "privacy_scope",
    "baseline",
    "contract_inventory",
    "components",
    "models",
    "routing",
    "data_artifacts",
    "data_parts",
    "installation_matrix",
    "capabilities",
    "pending_gates",
    "rollback",
    "mutable_state_policy"
