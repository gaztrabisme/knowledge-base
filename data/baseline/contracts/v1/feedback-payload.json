{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pi-mind:contracts:feedback-payload:1",
  "title": "feedback-payload",
  "type": "object",
  "required": [
    "target",
    "outcome",
    "evidence",
    "reviewer_or_check",
    "explanation"
  ],
  "properties": {
    "target": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "target_type",
            "target_id",
            "target_revision"
          ],
          "properties": {
            "target_type": {
              "type": "string",
              "const": "memory_record"
            },
            "target_id": {
              "type": "string",
              "minLength": 1
            },
            "target_revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "target_type",
            "target_id",
            "target_revision"
          ],
          "properties": {
            "target_type": {
              "type": "string",
              "const": "source"
            },
            "target_id": {
              "type": "string",
              "minLength": 1
            },
            "target_revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string",
          "const": "helpful"
        },
        {
          "type": "string",
          "const": "harmful"
        },
        {
          "type": "string",
          "const": "neutral"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "type",
              "id",
              "revision",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "memory_record"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "path",
              "content_sha256",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "file"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "sha",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "commit"
              },
              "sha": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
              },
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "url",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "url"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "session_id",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "session"
              },
              "session_id": {
                "type": "string",
                "minLength": 1
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "reviewer_or_check": {
      "type": "object",
      "required": [
        "writer",
        "writer_assurance"
      ],
      "properties": {
        "writer": {
          "type": "string",
          "minLength": 1
        },
        "writer_assurance": {
          "anyOf": [
            {
              "type": "string",
              "const": "configured"
            },
            {
              "type": "string",
              "const": "authenticated"
            }
          ]
        },
        "check_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
