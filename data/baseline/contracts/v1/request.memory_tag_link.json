{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:organized-mind:request.memory_tag_link:1",
  "title": "request.memory_tag_link",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "mind-tool-request/v1"
    },
    "operation": {
      "const": "memory_tag_link"
    },
    "arguments": {
      "type": "object",
      "properties": {
        "request_key": {
          "type": "string",
          "minLength": 1
        },
        "owner_scope": {
          "type": "string",
          "minLength": 1
        },
        "project_scope": {
          "type": "string",
          "minLength": 1
        },
        "assertion_type": {
          "anyOf": [
            {
              "type": "string",
              "const": "observation"
            },
            {
              "type": "string",
              "const": "inference"
            },
            {
              "type": "string",
              "const": "user_statement"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "urn:organized-mind:contribution-evidence-reference:1"
          }
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "claimed_harness": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_due_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "contradicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "subject": {
          "$ref": "urn:pi-mind:contracts:target-reference:1"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "$ref": "urn:pi-mind:contracts:target-reference:1"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "request_key",
        "owner_scope",
        "project_scope",
        "assertion_type",
        "subject",
        "rationale"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "tag"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "predicate"
                ]
              },
              {
                "required": [
                  "object"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "predicate",
            "object",
            "applicability"
          ],
          "not": {
            "required": [
              "tag"
            ]
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "owner_scope": {
          "type": "string",
          "minLength": 1
        },
        "project_scope": {
          "type": "string",
          "minLength": 1
        },
        "privacy_scope": {
          "enum": [
            "owner-private",
            "project-private"
          ]
        },
        "question_budget_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "owner_scope",
        "project_scope",
        "privacy_scope"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "operation",
    "arguments",
    "context"
  ],
  "additionalProperties": false
}
