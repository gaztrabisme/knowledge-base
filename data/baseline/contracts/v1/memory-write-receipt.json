{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pi-mind:contracts:memory-write-receipt:1",
  "title": "memory-write-receipt",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "revision",
    "request_key",
    "provenance",
    "saved",
    "indexed",
    "backend_availability",
    "privacy_scope",
    "error",
    "omitted_count"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pi-mind/memory-write-receipt@1"
    },
    "id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "request_key": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "origin",
        "writer",
        "writer_assurance",
        "claimed_harness",
        "model",
        "session_id",
        "run_id",
        "created_at"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1,
          "description": "A claimed value, or the literal \"not found\" when unavailable; not authorization."
        },
        "writer": {
          "type": "string",
          "minLength": 1
        },
        "writer_assurance": {
          "anyOf": [
            {
              "type": "string",
              "const": "configured"
            },
            {
              "type": "string",
              "const": "authenticated"
            }
          ]
        },
        "claimed_harness": {
          "type": "string",
          "minLength": 1,
          "description": "A claimed value, or the literal \"not found\" when unavailable; not authorization."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "A claimed value, or the literal \"not found\" when unavailable; not authorization."
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "description": "A claimed value, or the literal \"not found\" when unavailable; not authorization."
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "description": "A claimed value, or the literal \"not found\" when unavailable; not authorization."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "saved": {
      "type": "boolean"
    },
    "indexed": {
      "type": "boolean"
    },
    "backend_availability": {
      "type": "object",
      "required": [
        "journal",
        "index"
      ],
      "properties": {
        "journal": {
          "anyOf": [
            {
              "type": "string",
              "const": "ready"
            },
            {
              "type": "string",
              "const": "unavailable"
            }
          ]
        },
        "index": {
          "anyOf": [
            {
              "type": "string",
              "const": "ready"
            },
            {
              "type": "string",
              "const": "pending"
            },
            {
              "type": "string",
              "const": "unavailable"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "privacy_scope": {
      "anyOf": [
        {
          "type": "string",
          "const": "owner-private"
        },
        {
          "type": "string",
          "const": "project-private"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "validation"
                },
                {
                  "type": "string",
                  "const": "permission"
                },
                {
                  "type": "string",
                  "const": "revision_conflict"
                },
                {
                  "type": "string",
                  "const": "request_key_conflict"
                },
                {
                  "type": "string",
                  "const": "backend_unavailable"
                },
                {
                  "type": "string",
                  "const": "not_found"
                },
                {
                  "type": "string",
                  "const": "internal"
                }
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 1
            },
            "actual_revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "omitted_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "saved": {
            "const": true
          }
        },
        "required": [
          "saved"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "else": {
        "properties": {
          "indexed": {
            "const": false
          },
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "type": "null"
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "revision": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  ]
}
