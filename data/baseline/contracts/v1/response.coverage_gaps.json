{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:organized-mind:response.coverage_gaps:1",
  "title": "response.coverage_gaps",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "mind-tool-response/v1"
    },
    "data": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirement_id": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "not-acquired",
                  "not-indexed",
                  "extraction-incomplete",
                  "no-extracted-support",
                  "insufficient-support"
                ]
              },
              "certificate": {
                "type": "object",
                "properties": {
                  "snapshot": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "predicate": {
                    "type": "string",
                    "minLength": 1
                  },
                  "profile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required_units": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "processing": {
                    "type": "object",
                    "properties": {
                      "state": {
                        "enum": [
                          "missing",
                          "locked",
                          "failed",
                          "skipped",
                          "truncated",
                          "pending",
                          "valid-empty",
                          "completed"
                        ]
                      },
                      "expected": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "value": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "reason": {
                                "const": null
                              }
                            },
                            "required": [
                              "value",
                              "reason"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "value": {
                                "const": null
                              },
                              "reason": {
                                "const": "not found"
                              }
                            },
                            "required": [
                              "value",
                              "reason"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "attempted": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "value": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "reason": {
                                "const": null
                              }
                            },
                            "required": [
                              "value",
                              "reason"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "value": {
                                "const": null
                              },
                              "reason": {
                                "const": "not found"
                              }
                            },
                            "required": [
                              "value",
                              "reason"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "completed": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "value": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "reason": {
                                "const": null
                              }
                            },
                            "required": [
                              "value",
                              "reason"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "value": {
                                "const": null
                              },
                              "reason": {
                                "const": "not found"
                              }
                            },
                            "required": [
                              "value",
                              "reason"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "profile": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "errors": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "state",
                      "expected",
                      "attempted",
                      "completed",
                      "profile",
                      "errors"
                    ],
                    "additionalProperties": false
                  },
                  "omissions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "review_state": {
                    "enum": [
                      "pending",
                      "checked"
                    ]
                  }
                },
                "required": [
                  "snapshot",
                  "scope",
                  "predicate",
                  "profile",
                  "required_units",
                  "processing",
                  "omissions",
                  "review_state"
                ],
                "additionalProperties": false
              },
              "nearby_evidence": {
                "type": "array",
                "items": {
                  "$ref": "urn:organized-mind:evidence-read:1"
                }
              },
              "missing_units": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "latest_source_date": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "value": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time"
                          },
                          {
                            "type": "string",
                            "format": "date"
                          },
                          {
                            "type": "string",
                            "pattern": "^\\d{4}(-(?:0[1-9]|1[0-2]))?$"
                          }
                        ]
                      },
                      "reason": {
                        "const": null
                      }
                    },
                    "required": [
                      "value",
                      "reason"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "value": {
                        "const": null
                      },
                      "reason": {
                        "const": "not found"
                      }
                    },
                    "required": [
                      "value",
                      "reason"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "next_action": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "requirement_id",
              "state",
              "certificate",
              "nearby_evidence",
              "missing_units",
              "latest_source_date",
              "next_action"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata": {
      "$ref": "urn:organized-mind:read-metadata:1"
    }
  },
  "required": [
    "schema_version",
    "data",
    "metadata"
  ],
  "additionalProperties": false
}
