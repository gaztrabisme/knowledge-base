{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pi-mind:contracts:memory-audit-event:1",
  "title": "memory-audit-event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "record_id",
    "revision",
    "event_type",
    "actor",
    "writer_assurance",
    "at",
    "request_key"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pi-mind/memory-audit-event@1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "writer_assurance": {
      "anyOf": [
        {
          "type": "string",
          "const": "configured"
        },
        {
          "type": "string",
          "const": "authenticated"
        }
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "request_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
