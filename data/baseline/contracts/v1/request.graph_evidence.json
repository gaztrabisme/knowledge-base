{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:organized-mind:request.graph_evidence:1",
  "title": "request.graph_evidence",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "mind-tool-request/v1"
    },
    "operation": {
      "const": "graph_evidence"
    },
    "arguments": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "assertion_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "revision"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "entity_id"
          ]
        },
        {
          "required": [
            "assertion_id"
          ]
        }
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "owner_scope": {
          "type": "string",
          "minLength": 1
        },
        "project_scope": {
          "type": "string",
          "minLength": 1
        },
        "privacy_scope": {
          "enum": [
            "owner-private",
            "project-private"
          ]
        },
        "question_budget_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "owner_scope",
        "project_scope",
        "privacy_scope"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "operation",
    "arguments",
    "context"
  ],
  "additionalProperties": false
}
