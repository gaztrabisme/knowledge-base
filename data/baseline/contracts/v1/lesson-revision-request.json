{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pi-mind:contracts:lesson-revision-request:1",
  "title": "lesson-revision-request",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "expected_revision",
    "request_key",
    "owner_scope",
    "project_scope",
    "assertion_type",
    "evidence",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pi-mind/lesson-revision-request@1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "request_key": {
      "type": "string",
      "minLength": 1
    },
    "owner_scope": {
      "type": "string",
      "minLength": 1
    },
    "project_scope": {
      "type": "string",
      "minLength": 1
    },
    "assertion_type": {
      "anyOf": [
        {
          "type": "string",
          "const": "observation"
        },
        {
          "type": "string",
          "const": "inference"
        },
        {
          "type": "string",
          "const": "user_statement"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "type",
              "id",
              "revision",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "memory_record"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "path",
              "content_sha256",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "file"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "sha",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "commit"
              },
              "sha": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
              },
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "url",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "url"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "session_id",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "session"
              },
              "session_id": {
                "type": "string",
                "minLength": 1
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "claim",
        "context",
        "trigger",
        "recommended_action",
        "limits",
        "observed_outcome",
        "polarity",
        "support"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "recommended_action": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "string",
          "minLength": 1
        },
        "observed_outcome": {
          "type": "string",
          "minLength": 1,
          "description": "A claimed value, or the literal \"not found\" when unavailable; not authorization."
        },
        "polarity": {
          "anyOf": [
            {
              "type": "string",
              "const": "rule"
            },
            {
              "type": "string",
              "const": "anti-pattern"
            }
          ]
        },
        "support": {
          "type": "string",
          "const": "not found"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
