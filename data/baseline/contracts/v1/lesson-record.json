{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pi-mind:contracts:lesson-record:1",
  "title": "lesson-record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "revision",
    "owner_scope",
    "project_scope",
    "origin",
    "writer",
    "writer_assurance",
    "claimed_harness",
    "model",
    "session_id",
    "run_id",
    "created_at",
    "assertion_type",
    "status",
    "expires_at",
    "review_due_at",
    "last_reviewed_at",
    "last_supported_at",
    "supersedes",
    "contradicts",
    "related",
    "evidence",
    "kind",
    "payload_schema",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pi-mind/memory-record@1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "owner_scope": {
      "type": "string",
      "minLength": 1
    },
    "project_scope": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "minLength": 1,
      "description": "A claimed value, or the literal \"not found\" when unavailable; not authorization."
    },
    "writer": {
      "type": "string",
      "minLength": 1
    },
    "writer_assurance": {
      "anyOf": [
        {
          "type": "string",
          "const": "configured"
        },
        {
          "type": "string",
          "const": "authenticated"
        }
      ]
    },
    "claimed_harness": {
      "type": "string",
      "minLength": 1,
      "description": "A claimed value, or the literal \"not found\" when unavailable; not authorization."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "A claimed value, or the literal \"not found\" when unavailable; not authorization."
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "A claimed value, or the literal \"not found\" when unavailable; not authorization."
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "A claimed value, or the literal \"not found\" when unavailable; not authorization."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "assertion_type": {
      "anyOf": [
        {
          "type": "string",
          "const": "observation"
        },
        {
          "type": "string",
          "const": "inference"
        },
        {
          "type": "string",
          "const": "user_statement"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "const": "candidate"
        },
        {
          "type": "string",
          "const": "verified"
        },
        {
          "type": "string",
          "const": "contested"
        },
        {
          "type": "string",
          "const": "superseded"
        },
        {
          "type": "string",
          "const": "retired"
        }
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_due_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_reviewed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_supported_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contradicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "type",
              "id",
              "revision",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "memory_record"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "path",
              "content_sha256",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "file"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "sha",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "commit"
              },
              "sha": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
              },
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "url",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "url"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "session_id",
              "checked"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "session"
              },
              "session_id": {
                "type": "string",
                "minLength": 1
              },
              "checked": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "kind": {
      "type": "string",
      "const": "lesson"
    },
    "payload_schema": {
      "type": "string",
      "const": "mind/lesson@1"
    },
    "payload": {
      "type": "object",
      "required": [
        "claim",
        "context",
        "trigger",
        "recommended_action",
        "limits",
        "observed_outcome",
        "polarity",
        "support"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "recommended_action": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "string",
          "minLength": 1
        },
        "observed_outcome": {
          "type": "string",
          "minLength": 1,
          "description": "A claimed value, or the literal \"not found\" when unavailable; not authorization."
        },
        "polarity": {
          "anyOf": [
            {
              "type": "string",
              "const": "rule"
            },
            {
              "type": "string",
              "const": "anti-pattern"
            }
          ]
        },
        "support": {
          "type": "string",
          "const": "not found"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
